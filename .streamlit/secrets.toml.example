# Copy these values into Streamlit Cloud's app Secrets panel.
# Use the same names when running locally in .streamlit/secrets.toml.

REID_ADMIN_PASSWORD = "replace-with-a-long-random-password"
REID_TIMEZONE = "Asia/Kolkata"
REID_KNOWN_RETENTION_THRESHOLD = 0.45

[mysql]
host = "your-mysql-host"
port = 3306
user = "your-mysql-user"
password = "your-mysql-password"
database = "person_reid"

# Optional: use a provider-specific CA certificate when required.
# ssl_ca = "-----BEGIN CERTIFICATE-----\nreplace-with-your-ca-certificate\n-----END CERTIFICATE-----"