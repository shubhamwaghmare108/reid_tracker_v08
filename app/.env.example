# Local environment variables for the app
# Copy this file to app/.env only if a local app-specific environment file is needed.
# Replace every placeholder with real values.

REID_ADMIN_PASSWORD=replace-with-a-long-random-password
REID_TIMEZONE=Asia/Kolkata

REID_MYSQL_HOST=your-mysql-host
REID_MYSQL_PORT=3306
REID_MYSQL_USER=your-mysql-user
REID_MYSQL_PASSWORD=your-mysql-password
REID_MYSQL_DATABASE=person_reid

REID_KNOWN_RETENTION_THRESHOLD=0.45
