# Local environment variables for Person ReID
# Copy this file to .env and replace every placeholder with real values.

REID_ADMIN_PASSWORD=replace-with-a-long-random-password
REID_TIMEZONE=Asia/Kolkata

REID_MYSQL_HOST=your-mysql-host
REID_MYSQL_PORT=3306
REID_MYSQL_USER=your-mysql-user
REID_MYSQL_PASSWORD=your-mysql-password
REID_MYSQL_DATABASE=person_reid

REID_KNOWN_RETENTION_THRESHOLD=0.45
# REID_PROJECT_ROOT=D:/path/to/personId

# Occlusion-aware tracker tuning. Keep the defaults unless you have representative
# video data to validate a change.
REID_TRACKER_MAX_LOST_FRAMES=30
REID_TRACKER_MAX_OCCLUSION_FRAMES=45
REID_TRACKER_MAX_RECOVERY_FRAMES=180
REID_TRACKER_MAX_TRAJECTORY_HISTORY=30
REID_TRACKER_MAX_BODY_GALLERY=12
REID_TRACKER_MAX_FACE_GALLERY=6
REID_TRACKER_OCCLUSION_IOU_THRESHOLD=0.15
REID_TRACKER_RECOVERY_REID_THRESHOLD=0.78
REID_TRACKER_MOTION_GATE_THRESHOLD=4.0
REID_TRACKER_RECOVERY_MOTION_GATE=8.0
REID_TRACKER_TURN_THRESHOLD=0.75
REID_TRACKER_MOTION_CONFIDENCE_THRESHOLD=0.45
REID_TRACKER_GALLERY_UPDATE_THRESHOLD=0.72
REID_TRACKER_NORMAL_REID_GATE=0.20
REID_TRACKER_DETECTION_DEDUP_IOU=0.75
REID_TRACKER_MIN_DETECTION_CONFIDENCE=0.35
REID_TRACKER_MIN_DETECTION_WIDTH=20
REID_TRACKER_MIN_DETECTION_HEIGHT=40
REID_TRACKER_MIN_DETECTION_AREA=1200
REID_TRACKER_DUPLICATE_TRACK_IOU=0.70
REID_TRACKER_DUPLICATE_APPEARANCE_THRESHOLD=0.80
REID_TRACKER_MAX_VISUAL_OCCLUSION_FRAMES=12
REID_TRACKER_IDENTITY_FACE_THRESHOLD=0.72
REID_TRACKER_IDENTITY_BODY_CANDIDATE_THRESHOLD=0.72
REID_TRACKER_IDENTITY_BODY_CONFIRM_THRESHOLD=0.84
REID_TRACKER_IDENTITY_MARGIN=0.08
REID_TRACKER_IDENTITY_CANDIDATE_MIN_FRAMES=4
REID_TRACKER_IDENTITY_RETENTION_FRAMES=45
# V06 association/ownership controls.  Defaults preserve V05 thresholds and
# favour a safe LOST/RETAINED state over a speculative handover.
REID_TRACKER_IDENTITY_LOCK_TIMEOUT=180
REID_TRACKER_RECOVERY_MARGIN=0.08
REID_TRACKER_ASSOCIATION_MIN_IOU=0.01
REID_TRACKER_ASSOCIATION_MAX_SCALE_CHANGE=2.85
REID_TRACKER_GALLERY_MIN_DETECTION_CONFIDENCE=0.70

METRICS_ENABLED=true
METRICS_EVENT_LOGGING=true
METRICS_OUTPUT_DIR=results
METRICS_LOG_DETECTIONS=false
METRICS_FLUSH_SIZE=500
